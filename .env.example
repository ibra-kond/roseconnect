# Clé API Google Gemini (https://aistudio.google.com/apikey)
# Laissez vide pour utiliser uniquement le mode scripté hors ligne.
GEMINI_API_KEY=

# Modèle Gemini. "gemini-flash-latest" suit automatiquement le dernier modèle Flash stable.
# Vous pouvez figer une version, par exemple : gemini-3.5-flash
GEMINI_MODEL=gemini-flash-latest

# Port du proxy Express local
PORT=8787
